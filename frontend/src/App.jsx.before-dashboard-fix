import React, { useEffect, useState } from "react";

const API_URL = "http://127.0.0.1:8000";
const WS_URL = "ws://127.0.0.1:8000/ws/events";

function App() {
  const [activePage, setActivePage] = useState("dashboard");
  const [devices, setDevices] = useState([]);
  const [events, setEvents] = useState([]);
  const [loading, setLoading] = useState(true);
  const [actionLoading, setActionLoading] = useState(null);
  const [wsConnected, setWsConnected] = useState(false);
  const [newDeviceAlert, setNewDeviceAlert] = useState(null);
  const [highlightedDeviceId, setHighlightedDeviceId] =
    useState(null);
  const [automationResult, setAutomationResult] = useState(null);

  const [deviceFilter, setDeviceFilter] = useState("all");
  const [vlanFilter, setVlanFilter] = useState("all");

  // ------------------------------------------------------------
  // LOAD DEVICES
  // ------------------------------------------------------------

  const loadDevices = async () => {
    try {
      const response = await fetch(`${API_URL}/devices/`);

      if (!response.ok) {
        throw new Error("Failed to load devices");
      }

      const data = await response.json();

      setDevices(Array.isArray(data) ? data : []);
    } catch (error) {
      console.error("Device loading error:", error);
    } finally {
      setLoading(false);
    }
  };

  // ------------------------------------------------------------
  // LOAD EVENTS
  // ------------------------------------------------------------

  const loadEvents = async () => {
    try {
      const response = await fetch(`${API_URL}/events/`);

      if (!response.ok) {
        throw new Error("Failed to load events");
      }

      const data = await response.json();

      setEvents(Array.isArray(data) ? data : []);
    } catch (error) {
      console.error("Event loading error:", error);
    }
  };

  // ------------------------------------------------------------
  // INITIAL LOAD + AUTO REFRESH
  // ------------------------------------------------------------

  useEffect(() => {
    loadDevices();
    loadEvents();

    const timer = setInterval(() => {
      loadDevices();
      loadEvents();
    }, 10000);

    return () => clearInterval(timer);
  }, []);

  // ------------------------------------------------------------
  // WEBSOCKET
  // ------------------------------------------------------------

  useEffect(() => {
    let socket;
    let reconnectTimer;

    const connect = () => {
      try {
        socket = new WebSocket(WS_URL);

        socket.onopen = () => {
          console.log("NETOPS WebSocket connected");
          setWsConnected(true);
        };

        socket.onmessage = (message) => {
          try {
            const event = JSON.parse(message.data);

            setEvents((previous) => {
              const exists = previous.some(
                (item) =>
                  item.id &&
                  event.id &&
                  item.id === event.id
              );

              if (exists) {
                return previous;
              }

              return [event, ...previous];
            });

            if (event.event_type === "new_device") {
              setNewDeviceAlert(event);
              setHighlightedDeviceId(event.device_id);

              loadDevices();

              setTimeout(() => {
                setNewDeviceAlert(null);
                setHighlightedDeviceId(null);
              }, 8000);
            }
          } catch (error) {
            console.error(
              "WebSocket event error:",
              error
            );
          }
        };

        socket.onerror = () => {
          setWsConnected(false);
        };

        socket.onclose = () => {
          setWsConnected(false);

          reconnectTimer = setTimeout(
            connect,
            5000
          );
        };
      } catch (error) {
        console.error(
          "WebSocket connection error:",
          error
        );

        reconnectTimer = setTimeout(
          connect,
          5000
        );
      }
    };

    connect();

    return () => {
      clearTimeout(reconnectTimer);

      if (socket) {
        socket.close();
      }
    };
  }, []);

  // ------------------------------------------------------------
  // DEVICE ACTION
  // ------------------------------------------------------------

  const deviceAction = async (
  deviceId,
  action,
  value = null
) => {
  const actionKey = `${action}-${deviceId}`;

  try {
    setActionLoading(actionKey);

    let url = `${API_URL}/devices/${deviceId}`;
    let method = "PATCH";
    let body = null;

    // ----------------------------------------------------------
    // APPROVE DEVICE
    // ----------------------------------------------------------

    if (action === "approve") {
      url += "/approve";
      method = "PATCH";
    }

    // ----------------------------------------------------------
    // REJECT DEVICE
    // ----------------------------------------------------------

    else if (action === "reject") {
      url += "/reject";
      method = "PATCH";
    }

    // ----------------------------------------------------------
    // CLASSIFY DEVICE
    // computer -> VLAN 20
    // cctv     -> VLAN 30
    // printer  -> VLAN 40
    // unknown  -> VLAN 90
    // ----------------------------------------------------------

    else if (action === "type") {
      url += "/type";
      method = "PATCH";

      body = JSON.stringify({
        device_type: value,
      });
    }

    // ----------------------------------------------------------
    // ALLOW INTERNET ACCESS
    // ----------------------------------------------------------

    else if (action === "allow") {
      url += "/allow";
      method = "POST";
    }

    // ----------------------------------------------------------
    // DISALLOW / QUARANTINE INTERNET ACCESS
    // ----------------------------------------------------------

    else if (
      action === "disallow" ||
      action === "quarantine"
    ) {
      url += "/disallow";
      method = "POST";
    }

    // ----------------------------------------------------------
    // ENFORCE CURRENT POLICY
    // ----------------------------------------------------------

    else if (action === "enforce") {
      url += "/enforce";
      method = "POST";
    }

    // ----------------------------------------------------------
    // AUTOMATIC VLAN ASSIGNMENT
    // ----------------------------------------------------------

    else if (action === "automate-vlan") {
      url += "/automate-vlan";
      method = "POST";
    }

    else {
      throw new Error(
        `Unsupported action: ${action}`
      );
    }

    const options = {
      method,
      headers: {
        "Content-Type": "application/json",
      },
    };

    if (body !== null) {
      options.body = body;
    }

    const response = await fetch(
      url,
      options
    );

    const responseText =
      await response.text();

    if (!response.ok) {
      throw new Error(
        responseText ||
          `HTTP ${response.status}`
      );
    }

    let result = {};

    if (responseText) {
      try {
        result = JSON.parse(
          responseText
        );
      } catch {
        result = {
          message: responseText,
        };
      }
    }

    console.log(
      "NETOPS action successful:",
      result
    );

    // Save VLAN automation result
    if (action === "automate-vlan") {
      setAutomationResult(result);
    }

    // Refresh devices and events
    await loadDevices();
    await loadEvents();

  } catch (error) {
    console.error(
      `Device action ${action} failed:`,
      error
    );

    alert(
      `Action failed: ${
        error.message ||
        "Unknown error"
      }`
    );

  } finally {
    setActionLoading(null);
  }
};
