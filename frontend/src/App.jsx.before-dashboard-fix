      <div className="app">
        <aside className="sidebar">
          <div className="brand">
            <div className="brand-mark">
              N
            </div>

            <div className="brand-text">
              <div className="brand-name">
                NETOPS
              </div>

              <div className="brand-subtitle">
                Network Operations
              </div>
            </div>
          </div>

          <nav className="nav">
            <div className="nav-section-title">
              OPERATIONS
            </div>

            <NavItem
              icon="D"
              label="Dashboard"
              active={
                activePage === "dashboard"
              }
              onClick={() =>
                setActivePage("dashboard")
              }
            />

            <NavItem
              icon="▣"
              label="Devices"
              active={
                activePage === "devices"
              }
              onClick={() => {
                setDeviceFilter("all");
                setActivePage("devices");
              }}
            />

            <NavItem
              icon="!"
              label="Events"
              active={
                activePage === "events"
              }
              onClick={() =>
                setActivePage("events")
              }
            />

            <NavItem
              icon="A"
              label="Access Control"
              active={
                activePage === "access"
              }
              onClick={() => {
                setDeviceFilter("all");
                setActivePage("access");
              }}
            />

            <div className="nav-section-title">
              AUTOMATION
            </div>

            <NavItem
              icon="V"
              label="VLAN Automation"
              active={
                activePage === "vlans"
              }
              onClick={() => {
                setVlanFilter("all");
                setActivePage("vlans");
              }}
            />

            <NavItem
              icon="R"
              label="Reports"
              active={
                activePage === "reports"
              }
              onClick={() =>
                setActivePage("reports")
              }
            />

            <div className="nav-section-title">
              SYSTEM
            </div>

            <NavItem
              icon="S"
              label="Settings"
              active={
                activePage === "settings"
              }
              onClick={() =>
                setActivePage("settings")
              }
            />
          </nav>

          <div className="sidebar-footer">
            <div className="system-status">
              <span className="status-dot online" />
              NETOPS online
            </div>
          </div>
        </aside>

        <main className="main">
          <header className="topbar">
            <div className="topbar-title">
              {getPageTitle(activePage)}
            </div>

            <div className="topbar-right">
              <div className="live-indicator">
                <span className="live-dot" />
                Live monitoring
              </div>
            </div>
          </header>

          {renderPage()}
        </main>

        {newDeviceAlert && (
          <div className="new-device-alert">
            <div className="alert-top" />

            <div className="alert-body">
              <div className="alert-label">
                NEW DEVICE DETECTED
              </div>

              <div className="alert-title">
                Network device requires review
              </div>

              <div className="alert-message">
                {newDeviceAlert.message ||
                  "A new device was discovered on the LAN."}
              </div>

              <button
                className="primary-button small"
                style={{
                  marginTop: "11px",
                }}
                onClick={() => {
                  setDeviceFilter("pending");
                  setActivePage("devices");
                  setNewDeviceAlert(null);
                }}
              >
                Review Device
              </button>
            </div>
          </div>
        )}

        {renderAutomationResult()}
      </div>
    </>
  );
}

// ============================================================
// COMPONENTS
// ============================================================

function NavItem({
  icon,
  label,
  active,
  onClick,
}) {
  return (
    <button
      className={
        active
          ? "nav-item active"
          : "nav-item"
      }
      onClick={onClick}
    >
      <span className="nav-icon">
        {icon}
      </span>

      <span className="nav-label">
        {label}
      </span>
    </button>
  );
}

function getPageTitle(page) {
  const titles = {
    dashboard:
      "Network Operations Dashboard",
    devices: "Device Management",
    events: "Network Events",
    access: "Access Control",
    vlans: "VLAN Automation",
    reports: "Network Reports",
    settings: "System Settings",
  };

  return titles[page] || "NETOPS";
}

function TypeBadge({ type }) {
  const normalized =
    type || "unknown";

  return (
    <span
      className={`type-badge ${normalized}`}
    >
      {normalized}
    </span>
  );
}

function StatusBadge({ value }) {
  const normalized =
    value || "unknown";

  return (
    <span
      className={`status-badge ${normalized}`}
    >
      {normalized}
    </span>
  );
}

function EnforcementBadge({ value }) {
  const normalized =
    value || "unknown";

  return (
    <span
      className={`enforcement-badge ${normalized}`}
    >
      {normalized}
    </span>
  );
}

function ClassificationRow({
  label,
  icon,
  type,
  value,
}) {
  return (
    <div className="classification-row">
      <div className="classification-name">
        <span
          className={`device-icon ${type}`}
        >
          {icon}
        </span>

        {label}
      </div>

      <div className="classification-value">
        {value}
      </div>
    </div>
  );
}

function VLANMini({
  vlan,
  name,
  count,
  quarantine = false,
}) {
  return (
    <div
      className={
        quarantine
          ? "vlan-mini quarantine"
          : "vlan-mini"
      }
    >
      <div className="vlan-mini-id">
        VLAN {vlan}
      </div>

      <div className="vlan-mini-name">
        {name}
      </div>

      <div className="vlan-mini-count">
        {count} device
        {count === 1 ? "" : "s"}
      </div>
    </div>
  );
}

function FilterBar({
  label,
  count,
  active,
  clear,
}) {
  return (
    <div className="device-filter-bar">
      <span>
        Showing:{" "}
        <strong>{label}</strong>{" "}
        <span>
          ({count})
        </span>
      </span>

      {active && (
        <button
          className="clear-filter-button"
          onClick={clear}
        >
          Show All
        </button>
      )}
    </div>
  );
}

function AccessSummary({
  title,
  value,
  text,
  onClick,
}) {
  return (
    <div
      className="access-summary-card"
      role="button"
      tabIndex={0}
      onClick={onClick}
      onKeyDown={(event) => {
        if (
          event.key === "Enter" ||
          event.key === " "
        ) {
          event.preventDefault();
          onClick();
        }
      }}
    >
      <span>{title}</span>

      <strong>{value}</strong>

      <small>
        {text} →
      </small>
    </div>
  );
}

function DeviceRow({
  device,
  actionLoading,
  highlighted,
  onAction,
}) {
  return (
    <tr
      className={
        highlighted ? "highlighted" : ""
      }
    >
      <td>
        <div className="device-primary">
          {device.hostname ||
            "Unknown Device"}
        </div>

        <div className="device-secondary">
          {device.mac_address}
        </div>
      </td>

      <td>
        {device.ip_address || "-"}
      </td>

      <td>
        <TypeBadge
          type={device.device_type}
        />
      </td>

      <td>
        <StatusBadge
          value={device.status}
        />
      </td>

      <td>
        <StatusBadge
          value={device.approval_status}
        />
      </td>

      <td>
        <StatusBadge
          value={
            device.access_decision ||
            "unknown"
          }
        />
      </td>

      <td>
        <EnforcementBadge
          value={
            device.enforcement_status
          }
        />
      </td>

      <td>
        <span className="vlan-badge">
          VLAN {device.vlan_id || "-"}
        </span>
      </td>

      <td>
        <div className="action-group">
          {device.approval_status ===
            "pending" && (
            <>
              <button
                className="approve-button"
                disabled={
                  actionLoading ===
                  `approve-${device.id}`
                }
                onClick={() =>
                  onAction(
                    device.id,
                    "approve"
                  )
                }
              >
                {actionLoading ===
                `approve-${device.id}`
                  ? "Approving..."
                  : "Approve"}
              </button>

              <button
                className="reject-button"
                disabled={
                  actionLoading ===
                  `reject-${device.id}`
                }
                onClick={() =>
                  onAction(
                    device.id,
                    "reject"
                  )
                }
              >
                {actionLoading ===
                `reject-${device.id}`
                  ? "Rejecting..."
                  : "Reject"}
              </button>
            </>
          )}

          <button
            className="secondary-button small"
            disabled={
              actionLoading ===
              `enforce-${device.id}`
            }
            onClick={() =>
              onAction(
                device.id,
                "enforce"
              )
            }
          >
            {actionLoading ===
            `enforce-${device.id}`
              ? "Enforcing..."
              : "Enforce"}
          </button>

          <button
            className="primary-button small"
            disabled={
              actionLoading ===
              `automate-vlan-${device.id}`
            }
            onClick={() =>
              onAction(
                device.id,
                "automate-vlan"
              )
            }
          >
            {actionLoading ===
            `automate-vlan-${device.id}`
              ? "Running..."
              : "Auto VLAN"}
          </button>
        </div>
      </td>
    </tr>
  );
}

function VLANCard({
  vlan,
  name,
  description,
  devices,
  selected,
  quarantine,
  onClick,
}) {
  return (
    <div
      className={[
        "vlan-card",
        selected
          ? "vlan-card-selected"
          : "",
        quarantine
          ? "quarantine"
          : "",
      ].join(" ")}
      onClick={onClick}
      role="button"
      tabIndex={0}
      onKeyDown={(event) => {
        if (
          event.key === "Enter" ||
          event.key === " "
        ) {
          event.preventDefault();
          onClick();
        }
      }}
    >
      <div className="vlan-card-top">
        <div className="vlan-number">
          VLAN {vlan}
        </div>

        <div>VIEW →</div>
      </div>

      <div className="vlan-name">
        {name}
      </div>

      <div className="vlan-description">
        {description}
      </div>

      <div className="vlan-count">
        {devices.length} device
        {devices.length === 1 ? "" : "s"}
      </div>

      {devices
        .slice(0, 4)
        .map((device) => (
          <div
            className="vlan-device"
            key={device.id}
          >
            <span>
              {device.hostname ||
                "Unknown"}
            </span>

            <span>
              {device.ip_address || "-"}
            </span>
          </div>
        ))}

      <div className="vlan-card-action">
        Show VLAN {vlan} devices →
      </div>
    </div>
  );
}

function PolicyRow({
  vlan,
  name,
  description,
  count,
  quarantine,
}) {
  return (
    <div
      className="vlan-policy-row"
      style={
        quarantine
          ? {
              borderBottomColor:
                "#422006",
            }
          : undefined
      }
    >
      <div className="vlan-policy-left">
        <div className="vlan-policy-number">
          {vlan}
        </div>

        <div>
          <div className="vlan-policy-name">
            {name}
          </div>

          <div className="vlan-policy-description">
            {description}
          </div>
        </div>
      </div>

      <div className="vlan-policy-count">
        {count}
      </div>
    </div>
  );
}

function ReportCard({
  title,
  value,
  description,
}) {
  return (
    <div className="report-card">
      <div className="report-card-title">
        {title}
      </div>

      <div className="report-card-value">
        {value}
      </div>

      <div className="report-card-description">
        {description}
      </div>
    </div>
  );
}

function EventRow({ event }) {
  const type =
    event.event_type || "event";

  let dotClass = "event-dot";

  if (
    type.includes("reject") ||
    type.includes("quarantine")
  ) {
    dotClass += " warning";
  }

  if (
    type.includes("approve") ||
    type.includes("allow")
  ) {
    dotClass += " success";
  }

  return (
    <div className="event-row">
      <span className={dotClass} />

      <div className="event-content">
        <div className="event-message">
          {event.message ||
            type}
        </div>

        <div className="event-meta">
          <span>{type}</span>

          {event.device_id && (
            <span>
              Device #{event.device_id}
            </span>
          )}

          {event.created_at && (
            <span>
              {event.created_at}
            </span>
          )}
        </div>
      </div>
    </div>
  );
}

function AutomationField({
  label,
  value,
}) {
  return (
    <div className="automation-field">
      <span>{label}</span>

      <strong>
        {value || "-"}
      </strong>
    </div>
  );
}

function PipelineStep({
  number,
  title,
  status,
}) {
  return (
    <div className="pipeline-step">
      <div className="pipeline-number">
        {number}
      </div>

      <div className="pipeline-title-text">
        {title}
      </div>

      <div className="pipeline-status">
        {status}
      </div>
    </div>
  );
}

export default App;
