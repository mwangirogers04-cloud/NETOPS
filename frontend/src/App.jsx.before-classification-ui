import { useEffect, useState } from "react";

const API_URL = "http://192.168.0.101:8000";
const WS_URL = "ws://192.168.0.101:8000/ws/events";

function App() {
  const [activePage, setActivePage] = useState("dashboard");
  const [devices, setDevices] = useState([]);
  const [events, setEvents] = useState([]);
  const [loading, setLoading] = useState(true);
  const [actionLoading, setActionLoading] = useState(null);
  const [wsConnected, setWsConnected] = useState(false);
  const [newDeviceAlert, setNewDeviceAlert] = useState(null);
  const [highlightedDeviceId, setHighlightedDeviceId] =
    useState(null);

  const loadDevices = async () => {
    try {
      const response = await fetch(`${API_URL}/devices/`);

      if (!response.ok) {
        throw new Error("Failed to load devices");
      }

      const data = await response.json();
      setDevices(data);
    } catch (error) {
      console.error("Device loading error:", error);
    }
  };

  const loadEvents = async () => {
    try {
      const response = await fetch(`${API_URL}/events/`);

      if (!response.ok) {
        throw new Error("Failed to load events");
      }

      const data = await response.json();
      setEvents(data);
    } catch (error) {
      console.error("Event loading error:", error);
    }
  };

  useEffect(() => {
    const loadInitialData = async () => {
      setLoading(true);

      await Promise.all([
        loadDevices(),
        loadEvents(),
      ]);

      setLoading(false);
    };

    loadInitialData();

    const interval = setInterval(() => {
      loadDevices();
      loadEvents();
    }, 10000);

    return () => clearInterval(interval);
  }, []);

  useEffect(() => {
    const websocket = new WebSocket(WS_URL);

    websocket.onopen = () => {
      console.log("NETOPS WebSocket connected");
      setWsConnected(true);
    };

    websocket.onmessage = (message) => {
      try {
        const data = JSON.parse(message.data);

        console.log("NETOPS WebSocket event:", data);

        if (data.type === "event" && data.event) {
          if (data.event.event_type === "new_device") {
            setNewDeviceAlert(data.event);
            setHighlightedDeviceId(
              data.event.device_id
            );
          }

          setEvents((currentEvents) => {
            const alreadyExists = currentEvents.some(
              (event) =>
                event.id === data.event.id
            );

            if (alreadyExists) {
              return currentEvents;
            }

            return [
              data.event,
              ...currentEvents,
            ];
          });

          loadDevices();
        }
      } catch (error) {
        console.error(
          "WebSocket message error:",
          error
        );
      }
    };

    websocket.onerror = (error) => {
      console.error(
        "NETOPS WebSocket error:",
        error
      );

      setWsConnected(false);
    };

    websocket.onclose = () => {
      console.log(
        "NETOPS WebSocket disconnected"
      );

      setWsConnected(false);
    };

    return () => {
      websocket.close();
    };
  }, []);

  const deviceAction = async (
    deviceId,
    action,
    deviceType = null
  ) => {
    const loadingKey = `${action}-${deviceId}`;

    setActionLoading(loadingKey);

    try {
      let response;

      if (action === "approve") {
        response = await fetch(
          `${API_URL}/devices/${deviceId}/approve`,
          {
            method: "PATCH",
          }
        );
      } else if (action === "reject") {
        response = await fetch(
          `${API_URL}/devices/${deviceId}/reject`,
          {
            method: "PATCH",
          }
        );
      } else if (action === "type") {
        response = await fetch(
          `${API_URL}/devices/${deviceId}/type`,
          {
            method: "PATCH",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              device_type: deviceType,
            }),
          }
        );
      } else if (action === "enforce") {
        response = await fetch(
          `${API_URL}/devices/${deviceId}/enforce`,
          {
            method: "POST",
          }
        );
      } else if (action === "automate-vlan") {
        response = await fetch(
          `${API_URL}/devices/${deviceId}/automate-vlan`,
          {
            method: "POST",
          }
        );
      } else {
        throw new Error(
          `Unknown device action: ${action}`
        );
      }

      if (!response.ok) {
        const errorText = await response.text();

        throw new Error(
          `HTTP ${response.status}: ${errorText}`
        );
      }

      const updatedDevice = await response.json();

      console.log(
        "NETOPS device action successful:",
        updatedDevice
      );

      if (
        action === "automate-vlan" &&
        updatedDevice &&
        updatedDevice.device_id
      ) {
        setDevices((currentDevices) =>
          currentDevices.map((device) =>
            device.id === updatedDevice.device_id
              ? {
                  ...device,
                  vlan_id:
                    updatedDevice.vlan_id,
                }
              : device
          )
        );
      } else if (
        updatedDevice &&
        updatedDevice.id
      ) {
        setDevices((currentDevices) =>
          currentDevices.map((device) =>
            device.id === deviceId
              ? {
                  ...device,
                  ...updatedDevice,
                }
              : device
          )
        );
      }

      await loadEvents();
      await loadDevices();
    } catch (error) {
      console.error(
        "NETOPS device action error:",
        error
      );

      alert(
        `Action failed: ${error.message}`
      );
    } finally {
      setActionLoading(null);
    }
  };

  const totalDevices = devices.length;

  const onlineDevices = devices.filter(
    (device) =>
      device.status === "online"
  ).length;

  const pendingDevices = devices.filter(
    (device) =>
      device.approval_status === "pending"
  ).length;

  const allowedDevices = devices.filter(
    (device) =>
      device.access_decision === "allowed"
  ).length;

  const quarantinedDevices = devices.filter(
    (device) =>
      device.access_decision === "quarantine"
  ).length;

  const computers = devices.filter(
    (device) =>
      device.device_type === "computer"
  ).length;

  const cctv = devices.filter(
    (device) =>
      device.device_type === "cctv"
  ).length;

  const printers = devices.filter(
    (device) =>
      device.device_type === "printer"
  ).length;

  const unknownDevices = devices.filter(
    (device) =>
      !device.device_type ||
      device.device_type === "unknown"
  ).length;

  const formatDate = (date) => {
    if (!date) {
      return "-";
    }

    return new Date(date).toLocaleString();
  };

  const navigation = [
    {
      id: "dashboard",
      label: "Dashboard",
      icon: "▦",
    },
    {
      id: "devices",
      label: "Devices",
      icon: "▣",
    },
    {
      id: "events",
      label: "Alerts & Events",
      icon: "⚠",
    },
    {
      id: "access",
      label: "Access Control",
      icon: "🔐",
    },
    {
      id: "vlans",
      label: "VLAN Management",
      icon: "◇",
    },
    {
      id: "reports",
      label: "Reports",
      icon: "▤",
    },
    {
      id: "settings",
      label: "Settings",
      icon: "⚙",
    },
  ];

  const StatCard = ({
    title,
    value,
    subtitle,
  }) => (
    <div className="stat-card">
      <div className="stat-title">
        {title}
      </div>

      <div className="stat-value">
        {value}
      </div>

      <div className="stat-subtitle">
        {subtitle}
      </div>
    </div>
  );

  const renderNewDeviceAlert = () => {
    if (!newDeviceAlert) {
      return null;
    }

    return (
      <div className="new-device-alert">
        <div className="new-device-alert-icon">
          🚨
        </div>

        <div className="new-device-alert-content">
          <strong>
            NEW DEVICE DETECTED
          </strong>

          <div className="new-device-alert-message">
            {newDeviceAlert.message}
          </div>

          <div className="new-device-alert-warning">
            Approval required before network access.
          </div>

          <div className="new-device-alert-actions">
            <button
              className="alert-review-button"
              onClick={() => {
                setHighlightedDeviceId(
                  newDeviceAlert.device_id
                );

                setNewDeviceAlert(null);
                setActivePage("devices");
              }}
            >
              Review Device
            </button>

            <button
              className="alert-dismiss-button"
              onClick={() =>
                setNewDeviceAlert(null)
              }
            >
              Dismiss
            </button>
          </div>
        </div>
      </div>
    );
  };

  const Dashboard = () => (
    <>
      <div className="page-header">
        <div>
          <h1>Network Dashboard</h1>

          <p>
            Real-time network and endpoint
            monitoring
          </p>
        </div>

        <div
          className={`monitor-status ${
            wsConnected
              ? "connected"
              : "disconnected"
          }`}
        >
          <span className="status-dot"></span>

          {wsConnected
            ? "LIVE MONITORING"
            : "CONNECTING"}
        </div>
      </div>

      <div className="stats-grid">
        <StatCard
          title="TOTAL DEVICES"
          value={totalDevices}
          subtitle="Discovered devices"
        />

        <StatCard
          title="ONLINE"
          value={onlineDevices}
          subtitle="Currently online"
        />

        <StatCard
          title="PENDING APPROVAL"
          value={pendingDevices}
          subtitle="Awaiting admin action"
        />

        <StatCard
          title="ALLOWED"
          value={allowedDevices}
          subtitle="Internet access allowed"
        />

        <StatCard
          title="QUARANTINED"
          value={quarantinedDevices}
          subtitle="Network access blocked"
        />
      </div>

      <div className="content-grid">
        <div className="panel">
          <div className="panel-header">
            <h2>Device Classification</h2>
          </div>

          <div className="classification-list">
            <div className="classification-row">
              <span>Computers</span>
              <strong>{computers}</strong>
            </div>

            <div className="classification-row">
              <span>CCTV Cameras</span>
              <strong>{cctv}</strong>
            </div>

            <div className="classification-row">
              <span>Printers</span>
              <strong>{printers}</strong>
            </div>

            <div className="classification-row">
              <span>Unknown</span>
              <strong>{unknownDevices}</strong>
            </div>
          </div>
        </div>

        <div className="panel">
          <div className="panel-header">
            <h2>Recent Events</h2>

            <button
              className="link-button"
              onClick={() =>
                setActivePage("events")
              }
            >
              View all
            </button>
          </div>

          <div className="event-list">
            {events.length === 0 ? (
              <div className="empty-state">
                No events recorded.
              </div>
            ) : (
              events
                .slice(0, 6)
                .map((event) => (
                  <div
                    className="event-item"
                    key={event.id}
                  >
                    <div className="event-icon">
                      ⚡
                    </div>

                    <div>
                      <div className="event-message">
                        {event.message}
                      </div>

                      <div className="event-time">
                        {formatDate(
                          event.created_at
                        )}
                      </div>
                    </div>
                  </div>
                ))
            )}
          </div>
        </div>
      </div>
    </>
  );

  const DevicesPage = () => (
    <>
      <div className="page-header">
        <div>
          <h1>Devices</h1>

          <p>
            Discover and manage network
            endpoints
          </p>
        </div>
      </div>

      <div className="panel table-panel">
        <div className="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>IP ADDRESS</th>
                <th>MAC ADDRESS</th>
                <th>TYPE</th>
                <th>VENDOR</th>
                <th>VLAN</th>
                <th>APPROVAL</th>
                <th>ACCESS</th>
                <th>STATUS</th>
                <th>ACTIONS</th>
              </tr>
            </thead>

            <tbody>
              {devices.map((device) => (
                <tr
                  key={device.id}
                  className={
                    device.id ===
                    highlightedDeviceId
                      ? "highlighted-device"
                      : ""
                  }
                >
                  <td>{device.id}</td>

                  <td>
                    {device.ip_address || "-"}
                  </td>

                  <td className="mono">
                    {device.mac_address}
                  </td>

                  <td>
                    {device.device_type ||
                      "Unknown"}
                  </td>

                  <td>
                    {device.vendor || "-"}
                  </td>

                  <td>
                    <span className="vlan-badge">
                      VLAN {device.vlan_id || "-"}
                    </span>
                  </td>

                  <td>
                    <span
                      className={`badge ${
                        device.approval_status
                      }`}
                    >
                      {device.approval_status}
                    </span>
                  </td>

                  <td>
                    <span
                      className={`badge ${
                        device.access_decision ===
                        "allowed"
                          ? "allowed"
                          : "quarantine"
                      }`}
                    >
                      {device.access_decision ||
                        "quarantine"}
                    </span>
                  </td>

                  <td>
                    <span
                      className={`status ${
                        device.status ===
                        "online"
                          ? "online"
                          : "offline"
                      }`}
                    >
                      {device.status}
                    </span>
                  </td>

                  <td>
                    <div className="action-buttons">
                      {device.approval_status !==
                        "approved" && (
                        <button
                          className="btn approve"
                          disabled={
                            actionLoading ===
                            `approve-${device.id}`
                          }
                          onClick={() =>
                            deviceAction(
                              device.id,
                              "approve"
                            )
                          }
                        >
                          ✓ Approve
                        </button>
                      )}

                      {device.approval_status !==
                        "rejected" && (
                        <button
                          className="btn reject"
                          disabled={
                            actionLoading ===
                            `reject-${device.id}`
                          }
                          onClick={() =>
                            deviceAction(
                              device.id,
                              "reject"
                            )
                          }
                        >
                          ✕ Reject
                        </button>
                      )}

                      <button
                        className="btn type"
                        disabled={
                          actionLoading ===
                          `type-${device.id}`
                        }
                        onClick={() =>
                          deviceAction(
                            device.id,
                            "type",
                            "computer"
                          )
                        }
                      >
                        💻 Computer
                      </button>

                      <button
                        className="btn type"
                        disabled={
                          actionLoading ===
                          `type-${device.id}`
                        }
                        onClick={() =>
                          deviceAction(
                            device.id,
                            "type",
                            "cctv"
                          )
                        }
                      >
                        📹 CCTV
                      </button>

                      <button
                        className="btn type"
                        disabled={
                          actionLoading ===
                          `type-${device.id}`
                        }
                        onClick={() =>
                          deviceAction(
                            device.id,
                            "type",
                            "printer"
                          )
                        }
                      >
                        🖨 Printer
                      </button>

                      <button
                        className="btn type"
                        disabled={
                          actionLoading ===
                          `type-${device.id}`
                        }
                        onClick={() =>
                          deviceAction(
                            device.id,
                            "type",
                            "unknown"
                          )
                        }
                      >
                        🔒 Unknown
                      </button>

                      <button
                        className="btn vlan-auto"
                        disabled={
                          actionLoading ===
                          `automate-vlan-${device.id}`
                        }
                        onClick={() =>
                          deviceAction(
                            device.id,
                            "automate-vlan"
                          )
                        }
                      >
                        🔄 Auto VLAN
                      </button>

                      <button
                        className="btn enforce"
                        disabled={
                          actionLoading ===
                          `enforce-${device.id}`
                        }
                        onClick={() =>
                          deviceAction(
                            device.id,
                            "enforce"
                          )
                        }
                      >
                        🔐 Enforce
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>

          {devices.length === 0 && (
            <div className="empty-state">
              No devices discovered.
            </div>
          )}
        </div>
      </div>
    </>
  );

  const EventsPage = () => (
    <>
      <div className="page-header">
        <div>
          <h1>Alerts & Events</h1>

          <p>
            Real-time NETOPS activity
          </p>
        </div>

        <div
          className={`monitor-status ${
            wsConnected
              ? "connected"
              : "disconnected"
          }`}
        >
          <span className="status-dot"></span>

          {wsConnected
            ? "WEBSOCKET CONNECTED"
            : "WEBSOCKET DISCONNECTED"}
        </div>
      </div>

      <div className="panel">
        <div className="event-list large">
          {events.length === 0 ? (
            <div className="empty-state">
              No events recorded.
            </div>
          ) : (
            events.map((event) => (
              <div
                className="event-item"
                key={event.id}
              >
                <div className="event-icon">
                  ⚡
                </div>

                <div>
                  <div className="event-type">
                    {event.event_type}
                  </div>

                  <div className="event-message">
                    {event.message}
                  </div>

                  <div className="event-time">
                    {formatDate(
                      event.created_at
                    )}
                  </div>
                </div>
              </div>
            ))
          )}
        </div>
      </div>
    </>
  );

  const AccessPage = () => (
    <>
      <div className="page-header">
        <div>
          <h1>Access Control</h1>

          <p>
            Control network access for
            discovered devices
          </p>
        </div>
      </div>

      <div className="stats-grid three">
        <StatCard
          title="ALLOWED"
          value={allowedDevices}
          subtitle="Network access permitted"
        />

        <StatCard
          title="QUARANTINED"
          value={quarantinedDevices}
          subtitle="Network access blocked"
        />

        <StatCard
          title="PENDING"
          value={pendingDevices}
          subtitle="Waiting for approval"
        />
      </div>

      <div className="panel table-panel">
        <div className="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>DEVICE</th>
                <th>TYPE</th>
                <th>VLAN</th>
                <th>APPROVAL</th>
                <th>ACCESS</th>
                <th>ACTION</th>
              </tr>
            </thead>

            <tbody>
              {devices.map((device) => (
                <tr key={device.id}>
                  <td>
                    {device.ip_address ||
                      device.mac_address}
                  </td>

                  <td>
                    {device.device_type ||
                      "Unknown"}
                  </td>

                  <td>
                    VLAN {device.vlan_id || "-"}
                  </td>

                  <td>
                    {device.approval_status}
                  </td>

                  <td>
                    <div className="access-status">
                      <span
                        className={`badge ${
                          device.access_decision ===
                          "allowed"
                            ? "allowed"
                            : "quarantine"
                        }`}
                      >
                        {device.access_decision ===
                        "allowed"
                          ? "ALLOWED — Internet Access"
                          : "QUARANTINED — No Internet Access"}
                      </span>

                      <div className="access-reason">
                        {device.access_reason ||
                          "Access status unavailable"}
                      </div>
                    </div>
                  </td>

                  <td>
                    <div className="action-buttons">
                      <button
                        className="btn vlan-auto"
                        disabled={
                          actionLoading ===
                          `automate-vlan-${device.id}`
                        }
                        onClick={() =>
                          deviceAction(
                            device.id,
                            "automate-vlan"
                          )
                        }
                      >
                        🔄 Auto VLAN
                      </button>

                      <button
                        className="btn enforce"
                        disabled={
                          actionLoading ===
                          `enforce-${device.id}`
                        }
                        onClick={() =>
                          deviceAction(
                            device.id,
                            "enforce"
                          )
                        }
                      >
                        🔐 Enforce
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </>
  );

  const VLANPage = () => {
    const vlans = [
      {
        id: 20,
        name: "Computers",
        icon: "💻",
        description:
          "Authorized computer endpoints",
        count: computers,
      },
      {
        id: 30,
        name: "CCTV Cameras",
        icon: "📹",
        description:
          "Security camera devices",
        count: cctv,
      },
      {
        id: 40,
        name: "Printers",
        icon: "🖨",
        description:
          "Network printer devices",
        count: printers,
      },
      {
        id: 90,
        name: "Quarantine",
        icon: "🔒",
        description:
          "Unknown or restricted devices",
        count: unknownDevices,
      },
    ];

    const getDevicesForVlan = (vlanId) => {
      return devices.filter(
        (device) =>
          Number(device.vlan_id) === vlanId
      );
    };

    return (
      <>
        <div className="page-header">
          <div>
            <h1>VLAN Management</h1>

            <p>
              Network segmentation and device
              assignment
            </p>
          </div>

          <div className="monitor-status connected">
            <span className="status-dot live"></span>
            VLAN POLICY ACTIVE
          </div>
        </div>

        <div className="vlan-grid">
          {vlans.map((vlan) => (
            <div
              className="vlan-card"
              key={vlan.id}
            >
              <div className="vlan-card-top">
                <div className="vlan-icon">
                  {vlan.icon}
                </div>

                <div className="vlan-number">
                  VLAN {vlan.id}
                </div>
              </div>

              <h2>{vlan.name}</h2>

              <p className="vlan-description">
                {vlan.description}
              </p>

              <div className="vlan-device-count">
                <strong>{vlan.count}</strong>{" "}
                devices
              </div>
            </div>
          ))}
        </div>

        <div className="panel">
          <div className="panel-header">
            <div>
              <h2>VLAN Device Assignments</h2>

              <div className="panel-subtitle">
                Devices currently assigned to
                each network segment
              </div>
            </div>
          </div>

          <div className="vlan-device-sections">
            {vlans.map((vlan) => {
              const vlanDevices =
                getDevicesForVlan(vlan.id);

              return (
                <div
                  className="vlan-device-section"
                  key={vlan.id}
                >
                  <div className="vlan-section-header">
                    <div>
                      <span className="vlan-section-icon">
                        {vlan.icon}
                      </span>

                      <strong>
                        VLAN {vlan.id} —{" "}
                        {vlan.name}
                      </strong>
                    </div>

                    <span className="vlan-section-count">
                      {vlanDevices.length} devices
                    </span>
                  </div>

                  {vlanDevices.length === 0 ? (
                    <div className="vlan-empty">
                      No devices currently assigned
                      to this VLAN.
                    </div>
                  ) : (
                    <div className="vlan-device-table">
                      <table>
                        <thead>
                          <tr>
                            <th>ID</th>
                            <th>IP ADDRESS</th>
                            <th>MAC ADDRESS</th>
                            <th>HOSTNAME</th>
                            <th>VENDOR</th>
                            <th>TYPE</th>
                            <th>STATUS</th>
                            <th>ACCESS</th>
                          </tr>
                        </thead>

