# NETOPS application
APP_NAME=NETOPS
APP_ENV=production
DEBUG=false

# PostgreSQL: replace with the private production database URL
DATABASE_URL=postgresql+psycopg://netops_user:CHANGE_ME@db:5432/netops

# Production frontend origin: replace with your actual HTTPS domain
CORS_ORIGINS=https://your-netops-domain.example

# Cisco integration: configure only when authorized switch access is available
NETOPS_SWITCH_MANAGEMENT_IP=
NETOPS_SWITCH_USERNAME=
NETOPS_SWITCH_PASSWORD=
NETOPS_SWITCH_ENABLE_SECRET=
NETOPS_SWITCH_ALLOWED_IPS=

# Sophos integration: configure only after verifying the supported API and permissions
SOPHOS_BASE_URL=
SOPHOS_API_TOKEN=
SOPHOS_VERIFY_TLS=true
