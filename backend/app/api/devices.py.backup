from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy import select
from sqlalchemy.orm import Session

from ..database import get_db
from ..models.device import Device
from ..schemas.device import (
    DeviceCreate,
    DeviceResponse,
    DeviceTypeUpdate,
)
from ..services.vlan_policy import get_vlan_for_device_type
from ..services.access_policy import (
    get_access_decision,
    get_access_reason,
)
from ..services.network_enforcement import enforce_device_access
from ..services.vlan_automation import automate_vlan_assignment
from ..services.event_service import create_event


router = APIRouter(
    prefix="/devices",
    tags=["Devices"],
)


def add_access_information(device: Device):
    device.access_decision = get_access_decision(
        device.device_type,
        device.approval_status,
    )

    device.access_reason = get_access_reason(
        device.device_type,
        device.approval_status,
    )

    return device


@router.get("/", response_model=list[DeviceResponse])
def get_devices(
    db: Session = Depends(get_db),
):
    devices = db.scalars(
        select(Device).order_by(Device.id)
    ).all()

    for device in devices:
        add_access_information(device)

    return devices


@router.post(
    "/",
    response_model=DeviceResponse,
    status_code=201,
)
def create_device(
    device_data: DeviceCreate,
    db: Session = Depends(get_db),
):
    existing_device = db.scalar(
        select(Device).where(
            Device.mac_address == device_data.mac_address
        )
    )

    if existing_device:
        raise HTTPException(
            status_code=409,
            detail="Device with this MAC address already exists",
        )

    device = Device(
        **device_data.model_dump(exclude={"vlan_id"}),
        status="online",
        approval_status="pending",
        vlan_id=get_vlan_for_device_type(None),
    )

    db.add(device)
    db.commit()
    db.refresh(device)

    add_access_information(device)

    return device


@router.patch(
    "/{device_id}/approve",
    response_model=DeviceResponse,
)
def approve_device(
    device_id: int,
    db: Session = Depends(get_db),
):
    device = db.get(Device, device_id)

    if device is None:
        raise HTTPException(
            status_code=404,
            detail="Device not found",
        )

    if device.approval_status == "approved":
        raise HTTPException(
            status_code=400,
            detail="Device is already approved",
        )

    device.approval_status = "approved"

    db.commit()
    db.refresh(device)

    enforce_device_access(
        device,
        db,
    )

    add_access_information(device)

    return device


@router.patch(
    "/{device_id}/reject",
    response_model=DeviceResponse,
)
def reject_device(
    device_id: int,
    db: Session = Depends(get_db),
):
    device = db.get(Device, device_id)

    if device is None:
        raise HTTPException(
            status_code=404,
            detail="Device not found",
        )

    if device.approval_status == "rejected":
        raise HTTPException(
            status_code=400,
            detail="Device is already rejected",
        )

    device.approval_status = "rejected"

    db.commit()
    db.refresh(device)

    enforce_device_access(
        device,
        db,
    )

    add_access_information(device)

    return device


@router.patch(
    "/{device_id}/type",
    response_model=DeviceResponse,
)
def set_device_type(
    device_id: int,
    device_data: DeviceTypeUpdate,
    db: Session = Depends(get_db),
):
    device = db.get(Device, device_id)

    if device is None:
        raise HTTPException(
            status_code=404,
            detail="Device not found",
        )

    old_type = device.device_type
    old_vlan = device.vlan_id

    new_type = device_data.device_type

    # ---------------------------------------------------------
    # Validate device type
    # ---------------------------------------------------------

    allowed_types = {
        "computer",
        "cctv",
        "printer",
        "unknown",
    }

    if new_type not in allowed_types:
        raise HTTPException(
            status_code=400,
            detail=(
                "Invalid device type. "
                "Allowed values: computer, cctv, printer, unknown"
            ),
        )

    # ---------------------------------------------------------
    # Prevent unnecessary changes
    # ---------------------------------------------------------

    if old_type == new_type:
        raise HTTPException(
            status_code=400,
            detail="Device already has this classification",
        )

    # ---------------------------------------------------------
    # Update classification
    # ---------------------------------------------------------

    device.device_type = new_type

    new_vlan = get_vlan_for_device_type(
        new_type
    )

    device.vlan_id = new_vlan

    # ---------------------------------------------------------
    # Record classification change
    # ---------------------------------------------------------

    create_event(
        db,
        "device_classification",
        (
            f"Manual classification change for device "
            f"{device.ip_address} "
            f"({device.mac_address}): "
            f"{old_type or 'unknown'} -> {new_type}; "
            f"VLAN {old_vlan or 90} -> {new_vlan}"
        ),
        device.id,
    )

    # ---------------------------------------------------------
    # If classification resolves a previous mismatch,
    # record a dedicated resolution event.
    # ---------------------------------------------------------

    create_event(
        db,
        "classification_review",
        (
            f"Classification review completed for device "
            f"{device.ip_address} "
            f"({device.mac_address}). "
            f"Final classification: {new_type}. "
            f"Assigned VLAN: {new_vlan}."
        ),
        device.id,
    )

    db.commit()
    db.refresh(device)

    # ---------------------------------------------------------
    # Re-evaluate network access
    # ---------------------------------------------------------

    enforce_device_access(
        device,
        db,
    )

    add_access_information(device)

    return device


@router.get(
    "/{device_id}/access-decision",
)
def get_device_access_decision(
    device_id: int,
    db: Session = Depends(get_db),
):
    device = db.get(Device, device_id)

    if device is None:
        raise HTTPException(
            status_code=404,
            detail="Device not found",
        )

    decision = get_access_decision(
        device.device_type,
        device.approval_status,
    )

    reason = get_access_reason(
        device.device_type,
        device.approval_status,
    )

    return {
        "device_id": device.id,
        "device_type": device.device_type,
        "approval_status": device.approval_status,
        "vlan_id": device.vlan_id,
        "decision": decision,
        "reason": reason,
    }


@router.post(
    "/{device_id}/enforce",
)
def enforce_device(
    device_id: int,
    db: Session = Depends(get_db),
):
    device = db.get(Device, device_id)

    if device is None:
        raise HTTPException(
            status_code=404,
            detail="Device not found",
        )

    result = enforce_device_access(
        device,
        db,
    )

    return result


@router.post(
    "/{device_id}/automate-vlan",
)
def automate_device_vlan(
    device_id: int,
    db: Session = Depends(get_db),
):
    device = db.get(Device, device_id)

    if device is None:
        raise HTTPException(
            status_code=404,
            detail="Device not found",
        )

    result = automate_vlan_assignment(
        device,
        db,
    )

    return result
