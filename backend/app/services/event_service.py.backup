from sqlalchemy.orm import Session

from ..models.event import Event


def create_event(
    db: Session,
    event_type: str,
    message: str,
    device_id: int | None = None,
):
    event = Event(
        event_type=event_type,
        message=message,
        device_id=device_id,
    )

    db.add(event)
    db.commit()
    db.refresh(event)

    return event
